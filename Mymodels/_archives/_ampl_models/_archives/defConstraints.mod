param N := b/mu;


# Define variables and enforce that they be non-negative.
# TODO: 560 variable positive Y
# TODO: define intermediate variable lambda
var Y{j in 1..560} >= 0;
var Lambdah;
var Lambdas;
var LambdaX;
var LambdaY;

#var rho_g >=0;
var Prevalence_G = sum{k in infected_G} (Y[k])/N;
var Prevalence_C_and_G = sum{k in infected_C_and_G} (Y[k])/N;


#var N;
#var Y{i in 560} default 0;
#let N := sum{k in 1..560} (Y[k]);
s.t. clambdah: Lambdah = (betaIh*(sum{k in acute_H} (Y[k]))/N + betaCh*(sum{i in chronic_H} (Y[i]))/N);
s.t. clambdas: Lambdas = betas*(sum{k in infectious_S} (Y[k]))/N;
s.t. clambdaX: LambdaX = betaX*(sum{k in infectious_C} (Y[k]))/N;
s.t. clambdaY: LambdaY =  betaY*(sum{k in infectious_G} (Y[k]))/N;

model ODE_SICTPSEIIISSEIIS2_v6.mod;

s.t. c561: sum{i in 1..560} (Y[i]) = b/mu;
#s.t. c562: sum{i in 421..560} (Y[i]) >= 0.01*(b/mu); #gono 
#s.t. c563: sum{i in chronic_H} (Y[i]) + sum{i in acute_H} (Y[i]) >= 0.01*(b/mu); #hiv
#s.t. c564: sum{i in infected_S} (Y[i])  >= 0.01*(b/mu); #syphilis
#s.t. c565: sum{i in infected_C} (Y[i])  >= 0.01*(b/mu); #Ct